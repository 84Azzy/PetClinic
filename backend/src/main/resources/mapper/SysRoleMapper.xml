<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zzy.petclinic.rbac.system.SysRoleMapper">
  <select id="selectByUserId" resultType="com.zzy.petclinic.rbac.system.SysRole">
    <!-- 不恰当：字段不完整、未去重且没有稳定排序。
    select r.code, r.name, r.status, r.description
    from sys_user_role ur inner join sys_role r
    on r.id=ur.role_id
    where ur.user_id=#{userId} and r.status='ACTIVE'
    -->
    select distinct r.id, r.code, r.name, r.description, r.status, r.created_at, r.updated_at
    from sys_user_role ur
    inner join sys_role r on r.id = ur.role_id
    where ur.user_id = #{userId}
      and r.status = 'ACTIVE'
    order by r.id
  </select>

  <select id="countUsersByRoleId">
    select count(*)
    from sys_user_role
    where role_id=#{roleId}
  </select>

  <delete id="deletePermissionByRoleId">
    delete from sys_role_permission
    where role_id=#{roleId}
  </delete>

  <insert id="insertRolePermissions">
    insert into sys_role_permission(role_id,permission_id)
    values
    <foreach collection="permissionList" item="permissionId" separator=",">
      (#{roleId},#{permissionId})
    </foreach>
  </insert>
</mapper>
