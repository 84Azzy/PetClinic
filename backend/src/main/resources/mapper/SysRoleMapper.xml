<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zzy.petclinic.rbac.system.SysRoleMapper">
  <!--
    TODO selectByUserId：
    1. sys_user_role ur INNER JOIN sys_role r ON r.id = ur.role_id；
    2. WHERE ur.user_id = #{userId} AND r.status = 'ACTIVE'；
    3. SELECT DISTINCT 角色实体需要的全部列，并按 r.id 或 r.code 稳定排序；
    4. resultType 使用 com.zzy.petclinic.rbac.system.SysRole。
  -->
  <select id="selectByUserId" resultType="com.zzy.petclinic.rbac.system.SysRole">
    select r.code, r.name, r.status, r.description
    from sys_user_role ur inner join sys_role r
    on r.id=ur.role_id
    where ur.user_id=#{userId} and r.status='ACTIVE'
  </select>
</mapper>
