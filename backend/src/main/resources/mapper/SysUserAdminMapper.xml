<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zzy.petclinic.rbac.system.SysUserAdminMapper">
  <sql id="userFilters">
    <where>
      <if test="keyword != null and keyword.trim() != ''">
        and (
          username like concat('%', #{keyword}, '%')
          or display_name like concat('%', #{keyword}, '%')
          or phone like concat('%', #{keyword}, '%')
          or email like concat('%', #{keyword}, '%')
        )
      </if>
      <if test="status != null and status.trim() != ''">
        and status = #{status}
      </if>
    </where>
  </sql>

  <select id="selectPageUsers" resultType="com.zzy.petclinic.rbac.authentication.SysUser">
    <!-- 不恰当：token_type 不存在；裸 where 在没有筛选条件时会生成非法 SQL。
    select id, username, display_name, phone, email, account_type, status, token_type
    from sys_user
    where
    -->
    select id, username, display_name, phone, email, account_type, status, token_version,
           created_at, updated_at
    from sys_user
    <include refid="userFilters"/>
    order by id desc
    limit #{offset}, #{size}
  </select>

  <select id="countUsers" resultType="long">
    select count(*)
    from sys_user
    <include refid="userFilters"/>
  </select>

  <delete id="deleteRolesByUserId">
    <!-- 不恰当：DELETE 中的别名写法跨数据库兼容性差。 -->
    <!-- delete from sys_user_role ur where ur.user_id = #{userId} -->
    delete from sys_user_role
    where user_id = #{userId}
  </delete>

  <insert id="insertUserRoles">
    insert into sys_user_role(user_id, role_id)
    values
    <!-- 不恰当：Java 参数名是 roleIds，collection="ids" 会报 BindingException。 -->
    <!-- foreach collection="ids" -->
    <foreach collection="roleIds" item="roleId" separator=",">
      (#{userId}, #{roleId})
    </foreach>
  </insert>
</mapper>
