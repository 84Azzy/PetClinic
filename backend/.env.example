# Smart PetClinic 后端本地环境变量模板
# 复制为 backend/.env 后填写；不要提交包含真实密钥的 .env。

# 运行环境
spring.profiles.active=dev
SERVER_PORT=8080
APP_DATABASE_INITIALIZE=false
JWT_SECRET=ReplaceWithAtLeast32CharacterLocalJwtSecret
JWT_EXPIRATION_MINUTES=480

# MySQL
DB_NAME=petclinic
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root

# AI。填写 API Key 后把 AI_CHAT_MODEL 改为 openai。
AI_CHAT_MODEL=none
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 本地开发 COS。填写开发桶和受限 CAM 子用户密钥后再启用。
COS_ENABLED=false
COS_REGION=ap-shanghai
COS_BUCKET=
COS_PREFIX=petclinic/dev
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
