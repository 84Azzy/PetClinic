# Smart PetClinic 本地环境变量模板。
# docker compose 会自动读取根目录 .env；不要提交包含真实密钥的 .env。

# 运行环境
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
FRONTEND_PORT=5173
APP_DATABASE_INITIALIZE=false
JWT_SECRET=ReplaceWithAtLeast32CharacterLocalJwtSecret

# MySQL
DB_NAME=petclinic
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root

# AI。填写 API Key 后把 AI_CHAT_MODEL 改为 openai。
AI_CHAT_MODEL=none
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 本地开发 COS。生产环境使用 CVM 实例角色，不配置永久密钥。
COS_ENABLED=false
COS_REGION=ap-shanghai
COS_BUCKET=
COS_PREFIX=petclinic/dev
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
